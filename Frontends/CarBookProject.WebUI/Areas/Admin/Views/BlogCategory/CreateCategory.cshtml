@model CreateCategoryDto

@{
    ViewData["Title"] = "CreateCategory";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="page-content">
    <div class="container-fluid">

        <div class="row">
            <div class="col-12">
                <div class="page-title-box d-flex align-items-center justify-content-between">
                    <h4 class="mb-0 font-size-18">Yeni Kategori Oluşturma</h4>

                    <div class="page-title-right">
                        <ol class="breadcrumb m-0">
                            <li class="breadcrumb-item"><a href="javascript: void(0);">Pages</a></li>
                            <li class="breadcrumb-item active">Kategori Oluştur</li>
                        </ol>
                    </div>
                                
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-12">

                <div class="card">
                    <div class="card-body">
                    
                        <p class="card-subtitle mb-4">Lütfen Yeni Kategori Oluştururken Bilgileri Eksiksiz Doldurunuz..!!</p>

                        <form method="post">

                            <div class="form-group">
                                <label for="inputBannerTitle">Kategori Adı</label>
                                <input type="text" class="form-control" asp-for="CategoryName">
                            </div>
                            
                            <button type="submit" class="btn btn-success waves-effect waves-light">Oluştur</button>
                        </form>
                    
                    </div>
                </div>

            </div>
        </div>

    </div>
</div>







