@model List<ResultTestimonialDto>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="page-content">
    <div class="container-fluid">

        <div class="row">
            <div class="col-12">
                <div class="page-title-box d-flex align-items-center justify-content-between">
                    <h4 class="mb-0 font-size-18">Referanslar</h4>

                    <div class="page-title-right">
                        <ol class="breadcrumb m-0">
                            <li class="breadcrumb-item"><a href="javascript: void(0);">Pages</a></li>
                            <li class="breadcrumb-item active">Referanslar</li>
                        </ol>
                    </div>
                                
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-body">
                        <table id="basic-form" class="table dt-responsive nowrap">
                            <h4 class="card-title">Mevcut Referanslar</h4>

                            <thead>
                                <tr>
                                    <th>Görsel</th>
                                    <th>Referans Adı</th>
                                    <th>Ünvan</th>
                                    <th>Yorumu</th>
                                    <th>Güncelle</th>
                                    <th>Sil</th>
                                </tr>
                            </thead>
                                    
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td><img src="@item.imageUrl" width="50px;" height="50px;" /></td>
                                        <td>@item.name</td>
                                        <td>@item.title</td>
                                        <td>@item.comment</td>
                                        <td><a class="btn btn-primary btn-rounded" href="/Admin/Testimonial/UpdateTestimonial/@item.testimonialId">Güncelle</a></td>
                                        <td><a class="btn btn-danger btn-rounded" href="/Admin/Testimonial/RemoveTestimonial/@item.testimonialId">Sil</a></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>