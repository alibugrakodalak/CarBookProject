@model UpdateFooterAddressDto

@{
    ViewData["Title"] = "UpdateFooterAdress";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="page-content">
    <div class="container-fluid">

        <div class="row">
            <div class="col-12">
                <div class="page-title-box d-flex align-items-center justify-content-between">
                    <h4 class="mb-0 font-size-18">Alt Adres Verisi Güncelle</h4>

                    <div class="page-title-right">
                        <ol class="breadcrumb m-0">
                            <li class="breadcrumb-item"><a href="javascript: void(0);">Pages</a></li>
                            <li class="breadcrumb-item active">Alt Adres Güncelle</li>
                        </ol>
                    </div>
                                
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-12">

                <div class="card">
                    <div class="card-body">
                    
                        <p class="card-subtitle mb-4">Lütfen Alt Adres Güncellerken Bilgileri Eksiksiz Doldurunuz..!!</p>

                        <form method="post">

                            <input type="hidden" asp-for="FooterAddressId"/>

                            <div class="form-group">
                                <label for="inputFooterMail">Mail Adresi</label>
                                <input type="text" class="form-control" asp-for="FooterMail">
                            </div>

                            <div class="form-group">
                                <label for="inputFooterPhoneNumber">Telefon Numarası</label>
                                <input type="text" class="form-control" asp-for="FooterPhoneNumber" />
                            </div>

                            <div class="form-group">
                                <label for="inputFooterLocation">Konum</label>
                                <input type="text" class="form-control" asp-for="FooterLocation">
                            </div>

                            <div class="form-group">
                                <label for="inputFooterDescription">Açıklama Metni</label>
                                <textarea rows="4" type="text" class="form-control" asp-for="FooterDescription"></textarea>
                            </div>
                            
                            <button type="submit" class="btn btn-success waves-effect waves-light">Güncelle</button>
                        </form>
                    
                    </div>
                </div>

            </div>
        </div>

    </div>
</div>











