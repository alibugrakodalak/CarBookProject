@model List<ResultContactDto>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="page-content">
    <div class="container-fluid">

        <div class="row">
            <div class="col-12">
                <div class="page-title-box d-flex align-items-center justify-content-between">
                    <h4 class="mb-0 font-size-18">Gelen Mesajlar</h4>

                    <div class="page-title-right">
                        <ol class="breadcrumb m-0">
                            <li class="breadcrumb-item"><a href="javascript: void(0);">Pages</a></li>
                            <li class="breadcrumb-item active">Mesajlar</li>
                        </ol>
                    </div>
                                
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-body">

                        <h4 class="card-title">Mesajlar</h4>
                        <p class="card-subtitle mb-4">
                            İletişim Formundan Gelen Mesajları Buradan Görüntüleyebilirsiniz.
                        </p>

                        <table id="selection-datatable" class="table dt-responsive nowrap">
                            <thead>
                                <tr>
                                    <th>Gönderen</th>
                                    <th>Mail</th>
                                    <th>Konu</th>
                                    <th>Gönderme Tarihi</th>
                                    <th>Mesaj İçeriği:</th>
                                </tr>
                            </thead>

                                    
                            <tbody>

                                @foreach(var item in Model)
                                {
                                    <tr>
                                        <td>@item.Name</td>
                                        <td>@item.Email</td>
                                        <td>@item.Subject</td>
                                        <td>@item.SendDate.ToShortDateString()</td>
                                        <td>@item.Message</td>
                                    </tr>
                                }                                
                        
                            </tbody>
                        </table>
                                
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

