@model List<ResultSocialMediaDto>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="page-content">
    <div class="container-fluid">

        <div class="row">
            <div class="col-12">
                <div class="page-title-box d-flex align-items-center justify-content-between">
                    <h4 class="mb-0 font-size-18">Sosyal Medya Hesapları</h4>

                    <div class="page-title-right">
                        <ol class="breadcrumb m-0">
                            <li class="breadcrumb-item"><a href="javascript: void(0);">Pages</a></li>
                            <li class="breadcrumb-item active">Sosyal Medya</li>
                        </ol>
                    </div>
                                
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-body">
                        <table id="basic-form" class="table dt-responsive nowrap">
                            <h4 class="card-title">Sosyal Medya</h4>

                            <thead>
                                <tr>
                                    <th>Platform</th>
                                    <th>Hesap</th>
                                    <th>Güncelle</th>
                                    <th>Sil</th>
                                </tr>
                            </thead>
                                    
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@item.Name</td>
                                        <td><a class="btn btn-primary btn-rounded" href="/Admin/SocialMedia/SocialMediaDetail/@item.SocailMediaId">Hesaba Git</a></td>
                                        <td><a class="btn btn-success btn-rounded" href="/Admin/SocialMedia/UpdateSocialMedia/@item.SocailMediaId">Güncelle</a></td>
                                        <td><a class="btn btn-danger btn-rounded" href="/Admin/SocialMedia/RemoveSocialMedia/@item.SocailMediaId">Sil</a></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>