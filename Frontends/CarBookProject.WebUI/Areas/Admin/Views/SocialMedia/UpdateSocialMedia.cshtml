@model UpdateSocialMediaDto

@{
    ViewData["Title"] = "UpdateSocialMedia";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="page-content">
    <div class="container-fluid">

        <div class="row">
            <div class="col-12">
                <div class="page-title-box d-flex align-items-center justify-content-between">
                    <h4 class="mb-0 font-size-18">Sosyal Medya Güncelleme</h4>

                    <div class="page-title-right">
                        <ol class="breadcrumb m-0">
                            <li class="breadcrumb-item"><a href="javascript: void(0);">Pages</a></li>
                            <li class="breadcrumb-item active">Sosyal Medya Güncelle</li>
                        </ol>
                    </div>
                                
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-12">

                <div class="card">
                    <div class="card-body">
                    
                        <p class="card-subtitle mb-4">Lütfen Sosyal Medya Güncelleme Yaparken Bilgileri Eksiksiz Doldurunuz..!!</p>

                        <form method="post">

                            <input type="hidden" asp-for="SocailMediaId"/>

                            <div class="form-group">
                                <label for="inputName">Platform Adı</label>
                                <input type="text" class="form-control" asp-for="Name">
                            </div>

                            <div class="form-group">
                                <label for="inputIcon">Icon Url</label>
                                <input type="text" class="form-control" asp-for="Icon">
                            </div>

                            <div class="form-group">
                                <label for="inputUrl">Hesap Link</label>
                                <input type="text" class="form-control" asp-for="Url">
                            </div>
                            
                            <button type="submit" class="btn btn-success waves-effect waves-light">Güncelle</button>
                        </form>
                    
                    </div>
                </div>

            </div>
        </div>

    </div>
</div>

