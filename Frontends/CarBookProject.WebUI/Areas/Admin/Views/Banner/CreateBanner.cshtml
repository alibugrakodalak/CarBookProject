@model CreateBannerDto

@{
    ViewData["Title"] = "CreateBanner";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="page-content">
    <div class="container-fluid">

        <div class="row">
            <div class="col-12">
                <div class="page-title-box d-flex align-items-center justify-content-between">
                    <h4 class="mb-0 font-size-18">Yeni Banner Alanı Oluşturma</h4>

                    <div class="page-title-right">
                        <ol class="breadcrumb m-0">
                            <li class="breadcrumb-item"><a href="javascript: void(0);">Pages</a></li>
                            <li class="breadcrumb-item active">Banner Oluştur</li>
                        </ol>
                    </div>
                                
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-12">

                <div class="card">
                    <div class="card-body">
                    
                        <p class="card-subtitle mb-4">Lütfen Yeni Banner Alanı Oluştururken Bilgileri Eksiksiz Doldurunuz..!!</p>

                        <form method="post">

                            <div class="form-group">
                                <label for="inputBannerTitle">Başlık</label>
                                <input type="text" class="form-control" asp-for="BannerTitle">
                            </div>

                            <div class="form-group">
                                <label for="inputBannerDescription">Açıklama</label>
                                <textarea rows="3" type="text" class="form-control" asp-for="BannerDescription"></textarea>
                            </div>

                            <div class="form-group">
                                <label for="inputBannerVideoUrl">Video URL</label>
                                <input type="text" class="form-control" asp-for="BannerVideoUrl">
                            </div>

                            <div class="form-group">
                                <label for="inputBannerVideoDescription">Video Açıklaması</label>
                                <input type="text" class="form-control" asp-for="BannerVideoDescription">
                            </div>
                            
                            <button type="submit" class="btn btn-success waves-effect waves-light">Oluştur</button>
                        </form>
                    
                    </div>
                </div>

            </div>
        </div>

    </div>
</div>





