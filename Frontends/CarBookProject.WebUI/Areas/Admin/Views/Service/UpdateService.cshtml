@model UpdateServicesDto

@{
    ViewData["Title"] = "UpdateService";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="page-content">
    <div class="container-fluid">

        <div class="row">
            <div class="col-12">
                <div class="page-title-box d-flex align-items-center justify-content-between">
                    <h4 class="mb-0 font-size-18">Hizmet Güncelleme</h4>

                    <div class="page-title-right">
                        <ol class="breadcrumb m-0">
                            <li class="breadcrumb-item"><a href="javascript: void(0);">Pages</a></li>
                            <li class="breadcrumb-item active">Hizmet Güncelle</li>
                        </ol>
                    </div>
                                
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-12">

                <div class="card">
                    <div class="card-body">
                    
                        <p class="card-subtitle mb-4">Lütfen Hizmet Verisi Güncellerken Bilgileri Eksiksiz Doldurunuz..!!</p>

                        <form method="post">

                            <input type="hidden" asp-for="serviceId"/>

                            <div class="form-group">
                                <label for="inputServiceTitle">Başlık</label>
                                <input type="text" class="form-control" asp-for="serviceTitle">
                            </div>

                            <div class="form-group">
                                <label for="inputServiceDescription">Açıklama</label>
                                <textarea rows="5" type="text" class="form-control" asp-for="serviceDescription"></textarea>
                            </div>

                            <div class="form-group">
                                <label for="inputServiceIconUrl">Icon <i>URL Olarak Giriniz</i></label>
                                <input type="text" class="form-control" asp-for="serviceIconUrl">
                            </div>
                            
                            <button type="submit" class="btn btn-success waves-effect waves-light">Güncelle</button>
                        </form>
                    
                    </div>
                </div>

            </div>
        </div>

    </div>
</div>

