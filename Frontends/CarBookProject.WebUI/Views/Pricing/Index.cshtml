@model List<ResultCarPricingListWithModelDto>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/UILayout/Index.cshtml";
}

<section class="ftco-section ftco-cart">
	<div class="container">
		<div class="row">
			<div class="col-md-12 ftco-animate">
				<div class="car-list">
					<table class="table">
						<thead class="thead-primary">
							<tr class="text-center">
								<th>&nbsp;</th>
								<th>&nbsp;</th>
								<th class="bg-primary heading">Günlük Kiralama</th>
								<th class="bg-dark heading">Aylık Kiralama</th>
								<th class="bg-black heading">Yıllık Kiralama</th>
							</tr>
						</thead>
						@foreach (var item in Model)
						{
							<tbody>
								<tr class="">
									<td class="car-image"><div class="img" style="background-image:url(@item.CoverImageUrl);"></div></td>
									<td class="product-name">
										<h3>@item.BrandName @item.model</h3>
										<p class="mb-0 rated">
											<span>Puan:</span>
											<span class="ion-ios-star"></span>
											<span class="ion-ios-star"></span>
											<span class="ion-ios-star"></span>
											<span class="ion-ios-star"></span>
											<span class="ion-ios-star"></span>
										</p>
									</td>

									<td class="price">
										<p class="btn-custom"><a href="#">Kirala</a></p>
										<div class="price-rate">
											<h3>
												<span class="num"><small class="currency">₺</small> @item.dailyAmount</span>
												<span class="per">/ Günlük</span>
											</h3>
											<span class="subheading">₺50/ km aşımı</span>
										</div>
									</td>

									<td class="price">
										<p class="btn-custom"><a href="#">Kirala</a></p>
										<div class="price-rate">
											<h3>
												<span class="num"><small class="currency">₺</small> @item.monthlyAmount</span>
												<span class="per">/ Aylık</span>
											</h3>
											<span class="subheading">₺50/ km aşımı</span>
										</div>
									</td>

									<td class="price">
										<p class="btn-custom"><a href="#">Kirala</a></p>
										<div class="price-rate">
											<h3>
												<span class="num"><small class="currency">₺</small> @item.yearlyAmount</span>
												<span class="per">/ Yıllık</span>
											</h3>
											<span class="subheading">₺50/ km aşımı</span>
										</div>
									</td>
								</tr>
							</tbody>
						}
					</table>
				</div>

				<div class="row mt-5">
					<div class="col text-center">
						<div class="block-27">
							<ul>

								<li class="@(ViewBag.CurrentPage == 1 ? "disabled" : "")">
									<a href="?page=@(ViewBag.CurrentPage - 1)">&lt;</a>
								</li>

								@for (int i = Math.Max(1, (int)ViewBag.CurrentPage - 2);
									  i <= Math.Min((int)ViewBag.TotalPages, (int)ViewBag.CurrentPage + 2);
									  i++)
								{
									<li class="@(i == ViewBag.CurrentPage ? "active" : "")">
										@if (i == ViewBag.CurrentPage)
										{
											<span>@i</span>
										}
										else
										{
											<a href="?page=@i">@i</a>
										}
									</li>
								}

								<li class="@(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
									<a href="?page=@(ViewBag.CurrentPage + 1)">&gt;</a>
								</li>

							</ul>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>

