@model GetBlogByIdDto

<div class="col-md-8 ftco-animate">

    <h2 class="mb-3">@Model.BlogTitle</h2>
    <p>@Model.Description</p>
    <p>
        <img src="~/carbook-master/images/image_5.jpg" alt="" class="img-fluid">
    </p>

    @await Component.InvokeAsync("_BlogDetailTagCloudByBlogComponentPartial", new { id = ViewBag.blogId })
            
    @await Component.InvokeAsync("_BlogDetailAboutAuthorComponentPartial", new { id = ViewBag.blogId })

    <div class="pt-5 mt-5">
        <h3 class="mb-5">@ViewBag.commentCount Yorum</h3>
        @await Component.InvokeAsync("_CommentListComponentPartial", new { id = ViewBag.blogId })

        @* @await Component.InvokeAsync("_AddCommentComponentPartial") *@

        @await Html.PartialAsync("~/Views/Blog/AddComment.cshtml", new { id = ViewBag.blogId })
    </div>

</div> 