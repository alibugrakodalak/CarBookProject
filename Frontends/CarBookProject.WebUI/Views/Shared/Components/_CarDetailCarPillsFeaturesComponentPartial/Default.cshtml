@model List<ResultCarFeatureByCarIdDto>

<div class="tab-pane fade show active" id="pills-description" role="tabpanel" aria-labelledby="pills-description-tab">
    <div class="row">
        @{
            int columnSize = (int)Math.Ceiling(Model.Count / 3.0);
            var columns = new[]
            {
                Model.Take(columnSize).ToList(),
                Model.Skip(columnSize).Take(columnSize).ToList(),
                Model.Skip(columnSize * 2).ToList()
            };
        }

        @foreach (var column in columns)
        {
            <div class="col-md-4">
                <ul class="features">
                    @foreach (var item in column)
                    {
                        @if (item.Available == true)
                        {
                            <li class="check"><span class="ion-ios-checkmark"></span>@item.FeatureName</li>
                        }
                        else
                        {
                            <li class="remove"><span class="ion-ios-checkmark"></span>@item.FeatureName</li>
                        }
                    }
                </ul>
            </div>
        }
    </div>
</div>