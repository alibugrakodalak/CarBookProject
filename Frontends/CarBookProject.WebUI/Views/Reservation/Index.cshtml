@model CreateReservationDto
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/UILayout/Index.cshtml";
}

<div class="col-md-10 block-9 mb-md-5 ml-auto mr-auto mt-5">
    <form method="post" class="bg-light p-5 contact-form">
        <h3 class="alert alert-success">Araç Rezervasyon Formu</h3>
        <br />

        <input type="hidden" asp-for="CarId" value="@ViewBag.v3" class="form-control" />

        <div class="form-group">
            <input type="text" asp-for="Name" class="form-control" required placeholder="Adınız" />
        </div>

        <div class="form-group">
            <input type="text" asp-for="Surname" class="form-control" required placeholder="Soyadınız" />
        </div>

        <div class="form-group">
            <input type="email" asp-for="Email" class="form-control" required placeholder="Mail Adresi" />
        </div>

        <div class="form-group">
            <input type="text" asp-for="PhoneNumber" class="form-control" required placeholder="Telefon Numarası" />
        </div>

        <div class="form-group">
            <input type="text" asp-for="Age" class="form-control" placeholder="Yaşınız" />
        </div>

        <div class="form-group">
            <input type="text" asp-for="DriverLicenceYear" class="form-control" placeholder="Ehliyet Geçerlilik Yılı" />
        </div>

        <div class="form-group">
            <p class="card-title" style="color:black;">Teslim Alınacak Lokasyon</p>
            @Html.DropDownListFor(x => x.PickUpLocationID, (List<SelectListItem>)ViewBag.v, new { @class = "form-control", style = "color:black;"})
        </div>

        <div class="form-group">
            <p class="card-title" style="color:black;">Son Teslim Noktası</p>
            @Html.DropDownListFor(x => x.DropOffLocationID, (List<SelectListItem>)ViewBag.v, new { @class = "form-control", style = "color:black;" })

        </div>

        <div class="form-group">
            <textarea cols="30" asp-for="Description" rows="7" class="form-control" placeholder="Mesaj (isteğe bağlı)"></textarea>
        </div>

        <div class="form-group">
            <input type="submit" value="Gönder" class="btn btn-primary py-3 px-5">
        </div>

    </form>
          
</div>

