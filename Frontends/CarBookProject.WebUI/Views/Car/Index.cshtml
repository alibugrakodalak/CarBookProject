@model List<ResultCarPricingWithCarDto>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/UILayout/Index.cshtml";
}

<section class="ftco-section bg-light">
    <div class="container">
        <div class="row">
            @foreach(var item in Model)
            {
                <div class="col-md-4">
                    <div class="car-wrap rounded ftco-animate">
                        <div class="img rounded d-flex align-items-end" style="background-image: url(@item.CoverImageUrl);">
                        </div>
                        <div class="text">
                            <h2 class="mb-0"><a href="car-single.html">@item.Model</a></h2>
                            <div class="d-flex mb-3">
                                <span class="cat">@item.Brand</span>
                                <p class="price ml-auto">@item.Amount₺ <span>/günlük</span></p>
                            </div>
                            <p class="d-flex mb-0 d-block">
                                <a href="/Reservation/Index/@item.CarId" class="btn btn-primary py-2 mr-1">Kirala</a> 
                                <a href="/Car/CarDetail/@item.CarId" class="btn btn-secondary py-2 ml-1">Detaylar</a>
                            </p>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="row mt-5">
            <div class="col text-center">
                <div class="block-27">
                    <ul>

                        <li class="@(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                            <a href="?page=@(ViewBag.CurrentPage - 1)">&lt;</a>
                        </li>

                        @for (int i = Math.Max(1, (int)ViewBag.CurrentPage - 2);
                              i <= Math.Min((int)ViewBag.TotalPages, (int)ViewBag.CurrentPage + 2);
                              i++)
                        {
                            <li class="@(i == ViewBag.CurrentPage ? "active" : "")">
                                @if (i == ViewBag.CurrentPage)
                                {
                                    <span>@i</span>
                                }
                                else
                                {
                                    <a href="?page=@i">@i</a>
                                }
                            </li>
                        }

                        <li class="@(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                            <a href="?page=@(ViewBag.CurrentPage + 1)">&gt;</a>
                        </li>

                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>

